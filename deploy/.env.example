# Copy to .env and fill in. Generate keys with:
#   docker compose run --rm api python -m app.cli gen-keys
# NEVER commit the real .env file.

CCTV_ENVIRONMENT=production
CCTV_SECRET_KEY=
CCTV_CREDENTIALS_KEY=

POSTGRES_PASSWORD=

# Admin account created on first start only (change the password after logging in).
CCTV_FIRST_ADMIN_USERNAME=admin
CCTV_FIRST_ADMIN_PASSWORD=

# Where server recordings are stored (large disk / RAID volume).
RECORDINGS_DIR=./recordings
